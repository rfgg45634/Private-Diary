<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 背景：暖调深灰，整体比纯黑亮一档，OLED 下也不发死黑 -->
    <color name="paper_bg">#33302B</color>
    <color name="paper_bg_top">#3A352F</color>

    <!-- 主色：柔和蓝灰，用在编辑页顶部工具栏这类小面积强调上，跟暖背景形成一点点冷暖对比 -->
    <color name="ink_primary">#8298A5</color>
    <color name="ink_primary_dark">#1C2D3D</color>

    <!-- 模块强调色：饱和度较低的暖调，跟暖背景更协调，不会显得突兀发光 -->
    <color name="knowledge_accent">#74A683</color>
    <color name="knowledge_accent_light">#3C463E</color>
    <color name="diary_accent">#D0A15A</color>
    <color name="diary_accent_light">#4A3E2C</color>

    <!-- 卡片背景与分割线：比背景稍浅一档，暖色调保持一致 -->
    <color name="card_bg">#3E3933</color>
    <color name="divider">#4D463E</color>
    <color name="nav_indicator">#453F37</color>

    <!-- 文本色彩：不用冷白/纯白，压暗成偏暖的浅灰，长时间看不晃眼 -->
    <color name="text_primary">#C8C1B8</color>
    <color name="text_secondary">#8F8880</color>
    <color name="text_tertiary">#736D64</color>

    <color name="danger">#C97B72</color>

    <color name="search_highlight">#5C5230</color>
    <color name="search_highlight_current">#8A7A3E</color>

    <color name="white">#FFFFFF</color>
</resources>
