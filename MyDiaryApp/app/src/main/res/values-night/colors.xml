<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 背景：暖调深灰，比之前明显调亮一档，避免看起来像纯黑 -->
    <color name="paper_bg">#2A2622</color>
    <color name="paper_bg_top">#302B26</color>

    <!-- 主色：柔和蓝灰，用在编辑页顶部工具栏这类小面积强调上，跟暖背景形成一点点冷暖对比 -->
    <color name="ink_primary">#8298A5</color>
    <color name="ink_primary_dark">#1C2D3D</color>

    <!-- 模块强调色：饱和度较低的暖调，跟暖背景更协调，不会显得突兀发光 -->
    <color name="knowledge_accent">#74A683</color>
    <color name="knowledge_accent_light">#333F37</color>
    <color name="diary_accent">#D0A15A</color>
    <color name="diary_accent_light">#413524</color>

    <!-- 卡片背景与分割线：比背景稍浅一档，暖色调保持一致 -->
    <color name="card_bg">#34302A</color>
    <color name="divider">#453F38</color>
    <color name="nav_indicator">#3B362F</color>

    <!-- 文本色彩：不用冷白/纯白，用偏暖的浅灰，看久了更舒服 -->
    <color name="text_primary">#D8D2CA</color>
    <color name="text_secondary">#96908C</color>
    <color name="text_tertiary">#79746B</color>

    <color name="danger">#C97B72</color>

    <color name="search_highlight">#5C5230</color>
    <color name="search_highlight_current">#8A7A3E</color>

    <color name="white">#FFFFFF</color>
</resources>
