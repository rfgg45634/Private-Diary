<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 四角小角花，不抢标题 -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:alpha="0.7"
            android:scaleType="fitCenter"
            android:src="@drawable/ornament_corner_tl"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:alpha="0.7"
            android:scaleType="fitCenter"
            android:src="@drawable/ornament_corner_tr"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:alpha="0.7"
            android:scaleType="fitCenter"
            android:src="@drawable/ornament_corner_bl"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:alpha="0.7"
            android:scaleType="fitCenter"
            android:src="@drawable/ornament_corner_br"
            android:contentDescription="@null" />

        <!-- 居中标题 + 下方小装饰线 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="56dp"
            android:layout_marginVertical="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View android:layout_width="20dp" android:layout_height="1dp" android:background="@color/knowledge_accent" />
                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginHorizontal="6dp"
                    android:src="@drawable/ic_diamond"
                    app:tint="@color/knowledge_accent"
                    android:contentDescription="@null" />
                <View android:layout_width="20dp" android:layout_height="1dp" android:background="@color/knowledge_accent" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/dragHandle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:alpha="0.3"
            android:src="@drawable/ic_drag_handle"
            android:contentDescription="@string/drag_handle_desc" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
